# ── Arc Testnet ─────────────────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002
CHAIN_NAME=Arc Testnet
EXPLORER_URL=https://testnet.arcscan.app
# Arc's USDC ERC-20 interface (6 decimals). The same USDC is Arc's native gas token.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Printed by `forge script script/Deploy.s.sol ...`
VAULT_ADDRESS=

# ── Wallets (generate with `npm run keys`) ──────────────────
# Only OWNER needs faucet USDC (https://faucet.circle.com → Arc Testnet); `npm run setup` funds the rest.
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
MERCHANT_CLOUDTOOL_KEY=
MERCHANT_WEATHER_KEY=

# ── App ─────────────────────────────────────────────────────
PORT=8787
# Public URL (e.g. your ngrok https URL). QuickNode Streams posts to $PUBLIC_URL/webhooks/quicknode
PUBLIC_URL=http://localhost:8787

# ── QuickNode Streams ───────────────────────────────────────
# Security token from the Stream's settings tab (used to verify X-QN-Signature)
QN_STREAM_SECRET=
# true = alerts come only from Streams deliveries (turns the backup RPC poller off). Use true for the demo.
QN_STREAMS_PRIMARY=false

# ── ElevenLabs ──────────────────────────────────────────────
ELEVENLABS_API_KEY=
# Optional: any voice from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# ── Agent guardrails (off-chain, before it asks the vault) ──
AGENT_TASK_BUDGET_USD=0.10
AGENT_PRICE_SPIKE_X=2
